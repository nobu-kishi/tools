#!/bin/bash
set -euo pipefail

# NOTE: gh auth login済みが前提
repo_name=$(basename "$PWD")
visibility="private"
dry_run=false

while getopts ":pd" opt; do
  case ${opt} in
  d)
    dry_run=true
    ;;
  p)
    visibility="public"
    ;;
  \?)
    echo "Usage: $0 [-p] [-d]"
    echo "  -p    Make the repository public (default is private)"
    echo "  -d    Dry-run mode. Show repository name and visibility without creating it"
    exit 1
    ;;
  esac
done

if [ "$dry_run" = true ]; then
  echo "Dry-run: repository='$repo_name' visibility='$visibility'"
  exit 0
fi

gh repo create "$repo_name" "--${visibility}" --source=. --remote=origin --push
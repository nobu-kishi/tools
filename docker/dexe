#!/bin/bash

filter=$([[ "$(docker context show 2>/dev/null)" == "rancher-desktop" ]] && echo "k8s")

container_id=$(docker ps --format "{{.ID}} {{.Names}}" \
  | grep -v "${filter:-^$}" \
  | fzf --prompt="Select container: " \
  | awk '{print $1}')

if [[ -z "$container_id" ]]; then
  echo "No container selected."
  exit 1
fi

docker exec -it "$container_id" sh -c 'command -v bash > /dev/null && exec bash || exec sh'
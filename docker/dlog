#!/bin/bash

filter=$([[ "$(docker context show 2>/dev/null)" == "rancher-desktop" ]] && echo "k8s")

container_id=$(docker ps -a --format "{{.ID}} {{.Names}}" \
  | grep -v "${filter:-^$}" \
  | fzf --prompt="Select container to view logs: " \
  | awk '{print $1}')

if [[ -z "$container_id" ]]; then
  echo "No container selected."
  exit 1
fi

docker logs "$container_id"